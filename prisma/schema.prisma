generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Maps to retailers table created by SQL migrations (001/002) ──────────────
// CRITICAL: commission_rate and trust_score are NEVER ranking factors.
// Ranking uses ai_score + trust_score + price_history_score ONLY.
model Retailer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(255)
  domain            String    @unique @db.VarChar(255)
  market            String    @db.VarChar(10)
  has_affiliate     Boolean   @default(false)
  affiliate_network String?   @db.VarChar(100)
  affiliate_tag     String?   @db.VarChar(255)
  commission_rate   Decimal?  @default(0.00) @db.Decimal(5, 2)
  trust_score       Int       @default(70)
  trust_signals     Json?
  is_official_store Boolean   @default(false)
  seller_type       String    @db.VarChar(50)
  warranty_status   String    @default("varies") @db.VarChar(50)
  logo_url          String?   @db.VarChar(500)
  website_url       String?   @db.VarChar(500)
  notes             String?
  last_verified_at  DateTime?
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())

  price_history PriceHistory[]

  @@map("retailers")
}

// ── New table: raw scraped data from all 17 sources ───────────────────────────
// Populated by Apify webhooks (Week 2) and Playwright scrapers (Week 3).
// AI scoring (Brain 1 + Brain 2) runs async and fills ai_score/is_fake_deal.
model PriceHistory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  retailer_id  String    @db.Uuid
  retailer     Retailer  @relation(fields: [retailer_id], references: [id])
  product_name String    @db.VarChar(500)
  product_url  String    @db.VarChar(1000)
  price        Decimal?  @db.Decimal(12, 2)
  currency     String    @default("MYR") @db.VarChar(10)
  market       String    @db.VarChar(10)
  is_affiliate Boolean   @default(false)
  raw_data     Json
  apify_run_id String?   @db.VarChar(255)
  // AI scoring fields — populated async after storage
  ai_score     Int?
  is_fake_deal Boolean?
  ai_verdict   String?   @db.Text
  ai_scored_at DateTime?
  scraped_at   DateTime  @default(now())
  created_at   DateTime  @default(now())

  @@index([retailer_id])
  @@index([market])
  @@index([scraped_at])
  @@index([apify_run_id])
  @@map("price_history")
}
