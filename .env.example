# ── COPY THIS FILE TO .env AND FILL IN ALL VALUES ─────────────────────────────
# Run: cp .env.example .env
# Never commit .env to git — it contains secrets.

# ── CORE ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dealzoda:CHANGE_THIS_PASSWORD@localhost:5432/dealzoda
REDIS_URL=redis://localhost:6379
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
NEXTAUTH_URL=https://dealzoda.com
APP_ENV=production
NEXT_PUBLIC_APP_URL=https://dealzoda.com

# ── AUTHENTICATION ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=from-console.cloud.google.com
GOOGLE_CLIENT_SECRET=from-console.cloud.google.com
APPLE_CLIENT_ID=from-developer.apple.com
APPLE_CLIENT_SECRET=from-developer.apple.com

# ── GOOGLE CUSTOM SEARCH (free: 100/day → upgrade at $5/1000 queries) ──────────
# 1. Create key:    https://console.cloud.google.com → APIs → Custom Search JSON API
# 2. Create engine: https://programmablesearchengine.google.com
GOOGLE_CSE_API_KEY=your_key_from_console.cloud.google.com
GOOGLE_CSE_ID=your_search_engine_id
GOOGLE_CSE_DAILY_LIMIT=100
GOOGLE_CSE_CACHE_TTL=21600

# ── AI LAYER ───────────────────────────────────────────────────────────────────
# Claude (Primary — deal scoring, fake detection, cross-border analysis)
ANTHROPIC_API_KEY=sk-ant-from-console.anthropic.com
AI_MONTHLY_BUDGET_USD=50

# OpenAI (Fallback + bulk categorization)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-from-platform.openai.com

# Google Gemini (Structured HTML extraction — cheapest + fastest)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=from-aistudio.google.com

# ── SCRAPING ───────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=from-apify.com-console
SCRAPINGBEE_API_KEY=from-scrapingbee.com

# ── AFFILIATE NETWORKS ─────────────────────────────────────────────────────────
INVOLVE_ASIA_API_KEY=from-involve.asia-publisher-portal
INVOLVE_ASIA_PID=your_publisher_id
INVOLVE_ASIA_LAZADA_TAG=your_lazada_tag
INVOLVE_ASIA_SHOPEE_TAG=your_shopee_tag
INVOLVE_ASIA_BOOKING_TAG=your_booking_tag
INVOLVE_ASIA_AGODA_TAG=your_agoda_tag
AMAZON_ASSOCIATE_TAG_MY=dealzoda-my-20
AMAZON_ASSOCIATE_TAG_IN=dealzoda-in-21
AMAZON_ASSOCIATE_TAG_US=dealzoda-us-20
CJ_API_KEY=from-cj.com
VCOMMISSION_API_KEY=from-vcommission.com
BOOKING_AFFILIATE_ID=from-partners.booking.com
AGODA_PARTNER_ID=from-agoda.com-partners

# ── NOTIFICATIONS ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=from-@BotFather-on-Telegram
TELEGRAM_CHANNEL_ID=@DealZodaMY
RESEND_API_KEY=from-resend.com
FROM_EMAIL=alerts@dealzoda.com

# ── ZODA CREDITS ───────────────────────────────────────────────────────────────
CREDITS_FREE_TIER_SHARE=20
CREDITS_PREMIUM_SHARE=40
CREDITS_CASHOUT_MIN=2000
CREDITS_EXPIRY_DAYS=365

# ── ADMIN ──────────────────────────────────────────────────────────────────────
# Password to access /admin — change this before going live
ADMIN_PASSWORD=dealzoda2026
NEXT_PUBLIC_ADMIN_PASSWORD=dealzoda2026

# ── DATABASE CREDENTIALS (for Docker Compose) ──────────────────────────────────
POSTGRES_USER=dealzoda
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=dealzoda
